# RAKSHA Frontend — Environment Configuration Template
# Copy to .env.local (development) or configure at build time (production).
#
# PRODUCTION (Cloudflare Workers Static Assets): the frontend and the API
# share a single origin (e.g. https://app.raksha.ai), so VITE_API_URL can be
# left UNSET — the API client falls back to the same-origin relative path
# /api (see frontend/src/services/api.ts).
#
# Development (Vite dev server proxies /api -> http://localhost:8000):
VITE_API_URL=http://localhost:8000/api
