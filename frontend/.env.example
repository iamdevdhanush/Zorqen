# RAKSHA Frontend — Environment Configuration Template
# Copy to .env.local (development) or configure in Vercel (production).
#
# Production: set VITE_API_URL to the backend URL (must end in /api), e.g.
#   VITE_API_URL=https://raksha-ai-b8wf.onrender.com/api
# Vite bakes VITE_* values in at build time — redeploy on Vercel after changing.
VITE_API_URL=http://localhost:8000/api
