{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zorqen",
  "main": "src/worker.ts",
  "compatibility_date": "2026-05-03",
  "workers_dev": true,

  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },

  "observability": {
    "enabled": true
  }
}