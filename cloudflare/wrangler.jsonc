{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "raksha",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-19",
  "workers_dev": true,

  "vars": {
    "APP_ENV": "production",
    "FRONTEND_URL": "https://app.raksha.ai",
    "BACKEND_URL": "https://app.raksha.ai",
    "CORS_ORIGINS": "[\"https://app.raksha.ai\"]",
    "TRUSTED_HOSTS": "[\"app.raksha.ai\", \"*.workers.dev\"]",
    "GITHUB_CLIENT_ID": "",
    "GITHUB_REDIRECT_URI": "https://app.raksha.ai/api/auth/github/callback",
    "GROQ_MODEL": "openai/gpt-oss-20b",
    "GROK_MODEL": "grok-4-latest",
    "SANDBOX_ENABLED": "false"
  },

  "secrets": {
    "required": [
      "SECRET_KEY",
      "ENCRYPTION_KEY",
      "DATABASE_URL",
      "GITHUB_CLIENT_SECRET",
      "GROQ_API_KEY",
      "GROK_API_KEY"
    ]
  },

  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health*"]
  },

  "containers": [
    {
      "class_name": "RakshaContainer",
      "image": "../backend/Dockerfile",
      "instance_type": "standard-1",
      "max_instances": 1,
      "rollout_active_grace_period": 300
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "RAKSHA_CONTAINER",
        "class_name": "RakshaContainer"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RakshaContainer"]
    }
  ],

  "observability": {
    "enabled": true
  },

  "limits": {
    "cpu_ms": 5000,
    "subrequests": 200
  }
}