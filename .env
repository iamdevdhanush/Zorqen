# ==================================================
# RAKSHA — Environment Configuration
# ==================================================
# Copy this to .env and fill in your values

# ------- Application -------
APP_NAME=RAKSHA
APP_ENV=development
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# ------- Database -------
# SQLite (default, zero-setup)
DATABASE_URL=sqlite+aiosqlite:///./raksha.db

# ------- GitHub OAuth -------
# Create at: https://github.com/settings/applications/new
# Homepage URL: http://localhost:5173
# Authorization callback URL: http://localhost:8000/api/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback

# ------- Groq LLM -------
# Get free API key at: https://console.groq.com
GROQ_API_KEY=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
GROQ_MODEL=llama-3.3-70b-versatile

# ------- Docker Sandbox -------
SANDBOX_ENABLED=true
SANDBOX_NETWORK=none
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_LIMIT=0.5
SANDBOX_TIMEOUT=60

# ------- Demo Mode -------
DEMO_MODE_ENABLED=true

# ------- Security -------
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ------- Logging -------
LOG_LEVEL=INFO
