# ==================================================
# ZORQEN — Environment Configuration Template
# ==================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env — it contains real credentials.

# ------- Application -------
APP_NAME=ZORQEN
# development | production
APP_ENV=development
# REQUIRED in production — must be a long random secret.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
# Frontend origin.  In production: https://app.zorqen.ai (Cloudflare frontend)
FRONTEND_URL=http://localhost:5173
# Backend public URL.  In production: the Render backend URL (e.g. https://zorqen-api.onrender.com)
BACKEND_URL=http://localhost:8000

# ------- Database -------
# Local development (SQLite, zero setup). NEVER use SQLite in production.
DATABASE_URL=sqlite+aiosqlite:///./zorqen.db
#
# REQUIRED IN PRODUCTION — PostgreSQL + asyncpg.
# Set DATABASE_URL to the real connection string from your database provider.
#
#   DATABASE_URL=postgresql+asyncpg://USERNAME:PASSWORD@HOST:5432/DATABASE
#
# Render/Koyeb/Neon URLs start with postgres:// or postgresql:// —
# the app normalizes them to postgresql+asyncpg:// automatically.
# DO NOT put documentation placeholders here.  The app will fail to start.
#
# PostgreSQL pool settings (production tuning, optional):
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_RECYCLE=3600

# ------- GitHub OAuth -------
# Create at: https://github.com/settings/applications/new
#
# Local development:
#   Homepage URL:             http://localhost:5173
#   Authorization callback:  http://localhost:8000/api/auth/github/callback
#
# Production (Cloudflare frontend + Render backend):
#   Homepage URL:             https://app.zorqen.ai
#   Authorization callback:  https://<RENDER_BACKEND_URL>/api/auth/github/callback
#   (GITHUB_REDIRECT_URI below must match the callback exactly)
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback

# ------- Groq LLM (AI security reasoning + architecture analysis + remediation) -------
# Get a free API key at: https://console.groq.com
# Model must be a currently supported Groq model — see https://console.groq.com/docs/models
# Used by: architecture_analyst, security_reasoner, remediation_agent, ASK ZORQEN fallback
GROQ_API_KEY=your_groq_api_key_here
# Free Groq-hosted model. Do NOT use llama-3.3-70b-versatile — Groq removed it
# (HTTP 404 model_not_found). See https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-20b

# ------- Gemini (Google AI Studio) — ASK ZORQEN primary copilot -------
# Backend ONLY — key is NEVER sent to the frontend or logged.
# Get key at: https://aistudio.google.com/apikey
# If GEMINI_API_KEY is set, it takes priority over GROK_API_KEY / GROQ_API_KEY.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ------- Grok (xAI) — ASK ZORQEN fallback copilot -------
# Backend ONLY — key is NEVER sent to the frontend or logged.
# Get key at: https://console.x.ai
# If GROK_API_KEY is set, it takes priority over GROQ_API_KEY for ASK ZORQEN.
GROK_API_KEY=your_grok_api_key_here
GROK_MODEL=grok-4-latest

# ------- Security -------
# REQUIRED in production — AES-256-GCM key for GitHub token encryption at rest.
# Generate: python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24
# JSON list of allowed browser origins (production: the Cloudflare frontend origin).
# IMPORTANT: Never use ["*"] with credentials — browsers reject it.
# Local development:
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
# Production (REQUIRED — the app refuses to boot without it):
#   JSON array or comma-separated list of the real public frontend origin(s):
#   CORS_ORIGINS=["https://app.zorqen.ai"]
#   CORS_ORIGINS=https://app.zorqen.ai
#   localhost/127.0.0.1 origins are rejected in production.
#
# Optional: extra Host headers allowed to reach the API (derived from FRONTEND_URL + BACKEND_URL automatically).
# Render interim (before a custom domain is set): ["*.onrender.com"]

# ------- Docker Sandbox -------
SANDBOX_ENABLED=false
SANDBOX_NETWORK=none
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_LIMIT=0.5
SANDBOX_TIMEOUT=60

# ------- Logging -------
LOG_LEVEL=INFO
