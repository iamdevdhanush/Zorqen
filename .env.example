# ==================================================
# RAKSHA — Environment Configuration Template
# ==================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env — it may contain real credentials.

# ------- Application -------
APP_NAME=RAKSHA
# development | production
APP_ENV=development
# REQUIRED in production — set to a long random value (e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`)
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
# Frontend origin (Vercel domain in production)
FRONTEND_URL=http://localhost:5173
# Backend public URL — in production set this to the Koyeb public domain
# (also used to derive allowed Host headers)
BACKEND_URL=http://localhost:8000

# ------- Database -------
# Local development (SQLite, zero setup). Do NOT use this in production.
DATABASE_URL=sqlite+aiosqlite:///./raksha.db
#
# REQUIRED in production — PostgreSQL + asyncpg. Set DATABASE_URL to the real
# connection string from your database provider:
#
#   DATABASE_URL=postgresql+asyncpg://USERNAME:PASSWORD@HOST:5432/DATABASE
#
# Render/Koyeb/Neon usually hand you a URL starting with postgres:// or
# postgresql:// — the app normalizes those to postgresql+asyncpg://
# automatically, so you may paste them as-is.
#
# NEVER put real credentials here. If DATABASE_URL is missing, placeholder, or
# points at SQLite in production, the app fails to start with a clear error.

# ------- GitHub OAuth -------
# Create at: https://github.com/settings/applications/new
# Local development:
#   Homepage URL: http://localhost:5173
#   Authorization callback URL: http://localhost:8000/api/auth/github/callback
# Production:
#   Homepage URL: https://<your-vercel-domain>
#   Authorization callback URL: https://<your-koyeb-domain>/api/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback

# ------- Groq LLM -------
# Get free API key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ------- Grok (xAI) — ASK RAKSHA investigation copilot -------
# Backend only — the key is NEVER sent to the frontend. Get it at https://console.x.ai
# Set GROK_MODEL to a model your key can access, e.g. grok-4-latest or grok-3-mini.
GROK_API_KEY=your_grok_api_key_here
GROK_MODEL=grok-4-latest

# ------- Docker Sandbox -------
SANDBOX_ENABLED=true
SANDBOX_NETWORK=none
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_LIMIT=0.5
SANDBOX_TIMEOUT=60

# ------- Demo Mode -------
DEMO_MODE_ENABLED=true

# ------- Security -------
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24
# JSON list of allowed browser origins (production: only the Vercel domain)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
# Optional: extra Host headers allowed to reach the API.
# In production this is derived automatically from FRONTEND_URL + BACKEND_URL.
# TRUSTED_HOSTS=["https://example.com"]

# ------- Logging -------
LOG_LEVEL=INFO
