# ── Environment ─────────────────────────────────────────────────────────────
# Never commit real secrets. Use .env.example files as templates.
.env
.env.*
!.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# ── Node / Frontend ─────────────────────────────────────────────────────────
node_modules
dist
dist-ssr

