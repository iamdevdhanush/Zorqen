# ── Environment & Secrets ─────────────────────────────────────────────────────
# Never commit real secrets, private keys, or environment files.
# Use .env.example files as templates.
.env
.env.*
*.env
*.env.*
*.local
!.env.example
!**/.env.example
!frontend/.env.example
!backend/.env.example
!cloudflare/.env.example

# Private keys, certificates, credentials
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.pub
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
*credentials*.json
client_secret*.json

# ── Cloudflare Worker & Wrangler ──────────────────────────────────────────────
.wrangler/
**/.wrangler/
.dev.vars
.dev.vars.*
!.dev.vars.example

# ── Node / Frontend ───────────────────────────────────────────────────────────
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
**/dist-ssr/
.turbo/
.parcel-cache/
.cache/
**/.cache/
.eslintcache
.stylelintcache

# Package manager debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Python / Backend ──────────────────────────────────────────────────────────
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so

