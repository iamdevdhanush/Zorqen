*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Local databases & artifacts ─────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ── Logs ────────────────────────────────────────────────────────────────────
*.log
logs/

# ── OS / Editor / IDE ───────────────────────────────────────────────────────
